{
  "name": "hjemmekino-hugo-site",
  "version": "1.0.0",
  "description": "Hugo site for hjemmekino.github.io with Tailwind CSS",
  "scripts": {
    "build-css": "tailwindcss -i ./assets/css/tailwind.css -o ./static/css/tailwind.css --watch",
    "build-css-prod": "tailwindcss -i ./assets/css/tailwind.css -o ./static/css/tailwind.css --minify",
    "dev": "hugo server & npm run build-css",
    "build": "npm run build-css-prod && hugo"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.10",
    "tailwindcss": "^3.4.0"
  },
  "keywords": ["hugo", "tailwindcss", "hjemmekino"],
  "author": "Hjemmekino",
  "license": "ISC"
}